    "react-grid-layout": "^2.0.0",
    "motion": "^12.0.0",
    "@tanstack/react-table": "^8.21.3",
    "maplibre-gl": "^5.13.0",
    "zod": "^3.25.76",
    "lucide-react": "^0.575.0",
    "clsx": "^2.1.1",
