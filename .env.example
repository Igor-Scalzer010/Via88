# Copy to .env at the repository root. Never commit real credentials.
OPENAI_API_KEY=
# Required for natural-language questions; choose a model supporting structured output.
OPENAI_MODEL=gpt-6-luna
# Per-call controls. No automatic retry or accumulated spending cap by default.
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_RETRIES=0
OPENAI_TIMEOUT_SECONDS=60
DATA_DIR=data
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUN_TIMEOUT_SECONDS=120
